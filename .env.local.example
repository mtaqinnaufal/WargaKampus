# Project URL. Ini bukan secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser key. Isi salah satu:
# - publishable key baru: sb_publishable_...
# - atau anon key lama: eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only key untuk scripts/seed-demo.mjs. Isi salah satu:
# - secret key baru: sb_secret_...
# - atau service_role key lama: eyJ...
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Used for auth redirect links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
